create table investidores (
id serial primary key,
nome varchar(100) not null,
cpf char(11) unique not null,
nivel_experiencia int default 0 check (nivel_experiencia >= 0)
);

create table carteiras (
id serial primary key,
investidor_id int references investidores(id),
endereco_wallet varchar(100) unique not null,
rede_blockchain varchar(50) not null,
saldo_usd decimal(12,2) not null check (saldo_usd > 0),
status varchar(20) default 'ativa'
check (status in ('ativa', 'em analise', 'bloqueada', 'pausada'))
);

create table corretoras (
id serial primary key,
nome_exchange varchar(100) not null,
cnpj char(14) unique not null,
email_suporte varchar(150) unique not null
);

create table criptomoedas (
id serial primary key,
corretora_id int references corretoras(id),
nome_moeda varchar(100) not null,
preco_unitario_usd decimal (12,2) not null check (preco_unitario_usd > 0),
categoria varchar(20) default 'Layer1'
check (categoria in ('Layer1', 'DeFi', 'Memecoin', 'Stablecoin'))
);

create table transacoes_cripto (
id serial primary key,
carteira_id int references carteiras(id),
criptomoeda_id int references criptomoedas(id),
quantidade decimal (18,8) not null check (quantidade > 0)
valor_pago decimal(12,2) not null check (valor_pago > 0)
data_transacao timestamp not null default current_timestamp
);

